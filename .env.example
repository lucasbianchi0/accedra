# ── Formulario de contacto ─────────────────────────────────────────────────
# Copiar a .env.local (que NO se commitea) y completar.

# API key de Resend → https://resend.com/api-keys
RESEND_API_KEY=

# Remitente. Tiene que estar en un dominio verificado en Resend; si no, DMARC
# rebota el mail. No puede ser la dirección del visitante: esa va en reply-to.
CONTACT_FROM="Accedra Web <web@accedra.com.ar>"

# Destino de las consultas.
CONTACT_TO=info@accedra.com.ar

# ── Supabase ───────────────────────────────────────────────────────────────
# Persistencia de los leads con su atribución de campaña (tabla public.leads).
# Sin esto el formulario sigue funcionando: manda el mail y sólo deja un warning
# en el log. Lo que se pierde es saber de qué anuncio o búsqueda vino cada lead.
SUPABASE_URL=https://pjpebibjlqjwffafzhhh.supabase.co

# service_role, NO la anon: las tablas tienen RLS activa sin políticas, así que
# la anon no puede leer ni escribir nada. Saltea RLS por completo, es de uso
# exclusivo del servidor — por eso no lleva prefijo NEXT_PUBLIC_.
# Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Rate limiting (opcional pero recomendado en Vercel) ────────────────────
# Sin esto el contador vive en memoria y, al ser serverless, no frena a nadie:
# cada instancia tiene el suyo y se reciclan constantemente.
# Crear una base gratuita en https://console.upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
