# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla no tiene secretos y documenta qué variables hay que definir.
!.env.example

# claude code — settings.json (proyecto) se commitea; los locales no
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Planes de trabajo y datos de negocio. Es material de trabajo vivo: se edita
# seguido, tiene cifras de la cuenta de Ads y no aporta nada al código.
/plan/
# el CSV generado se puede regenerar con scripts/ads/generate.mjs
/scripts/ads/out/
